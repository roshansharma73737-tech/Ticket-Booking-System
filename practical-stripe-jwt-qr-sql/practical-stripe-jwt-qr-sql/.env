# Copy to .env and fill in your own values

# Stripe test keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_yourSecretKey
STRIPE_PUBLIC_KEY=pk_test_yourPublicKey

# Stripe CLI gives you this when running: stripe listen --forward-to localhost:3000/api/payment/webhook
STRIPE_WEBHOOK_SECRET=whsec_yourWebhookSecret
    
JWT_SECRET=someLongRandomSecretString123

# Used to build the UPI deep link for the India QR path
UPI_MERCHANT_VPA=merchant@okhdfcbank
UPI_MERCHANT_NAME=College Store

PORT=3000
